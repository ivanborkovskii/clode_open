# Переадресация с поддомена на основной домен.
#
# КУДА КЛАСТЬ: в корень поддомена crm.ivanborkovsky.ru, ЗАМЕНЯЯ прежний
# .htaccess. Это НЕ папка сайта ivanborkovsky.ru — туда этот файл класть
# нельзя ни в коем случае: он отправит сайт сам на себя по кругу.
#
# ЧТО ДЕЛАЕТ: переводит каждый адрес поддомена на такой же адрес
# основного домена. Сайт один и тот же, адреса совпадают один в один,
# поэтому сопоставлять страницы вручную не нужно:
#
#   crm.ivanborkovsky.ru/stati/nazvanie  →  ivanborkovsky.ru/stati/nazvanie
#
# СКОЛЬКО ДЕРЖАТЬ: минимум год. Поисковики переносят накопленное
# постепенно, и если убрать переадресацию раньше, потеряется и то,
# что успело перенестись.
#
# После выкладки этого файла остальные файлы сайта в папке поддомена
# не нужны — их можно удалить. Правила ниже сработают раньше, чем
# запрос дойдёт до чего-либо ещё.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Проверка прав на домен — мимо всех правил.
    #
    # По этому пути удостоверяющий центр проверяет, что домен ваш,
    # когда выпускает и продлевает сертификат. Сертификат поддомену
    # ещё нужен: без него переход с https на поддомене упрётся
    # в предупреждение браузера раньше, чем сработает переадресация.
    RewriteCond %{REQUEST_URI} ^/\.well-known/
    RewriteRule ^ - [L]

    # 2. Страховка от ошибки при выкладке.
    #
    # Правило ниже уводит с сайта ВСЁ. Если этот файл попадёт не в ту
    # папку, он закроет сайт целиком. Поэтому сначала проверяем имя:
    # не поддомен — ничего не делаем.
    #
    # Проверка нужна и для того, чтобы файл, случайно оказавшийся
    # в папке основного домена, не устроил бесконечное кольцо.
    RewriteCond %{HTTP_HOST} !^(www\.)?crm\.ivanborkovsky\.ru$ [NC]
    RewriteRule ^ - [L]

    # 3. Всё остальное — на тот же адрес основного домена.
    #
    # Код 301 — «переехали навсегда»: по нему поисковики переносят вес
    # старого адреса на новый и со временем заменяют его в выдаче.
    #
    # $1 — путь запроса целиком, поэтому страницы сопоставляются сами.
    # Метки рекламных кампаний Apache дописывает к новому адресу сам.
    RewriteRule ^(.*)$ https://ivanborkovsky.ru/$1 [L,R=301]
</IfModule>

# Список файлов в каталоге не показываем.
Options -Indexes
