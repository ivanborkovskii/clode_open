# Переезд основного домена на сайт по CRM.
#
# КУДА КЛАСТЬ: в корень домена ivanborkovsky.ru, ЗАМЕНЯЯ прежний .htaccess.
# Это НЕ папка сайта crm.ivanborkovsky.ru: у каждого домена своя папка.
#
# ЧТО ДЕЛАЕТ: закрывает старый сайт и переводит его адреса на новый.
# Похожие страницы ведут на свои — человек попадает туда, куда шёл,
# а поисковик переносит на новый адрес вес старого. Всё остальное
# уходит на главную.
#
# Старые файлы сайта при этом никуда не деваются и лежат на месте:
# если понадобится вернуть его, достаточно вернуть прежний .htaccess.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Проверка прав на домен — мимо всех правил.
    #
    # По этому пути удостоверяющий центр проверяет, что домен ваш,
    # когда выпускает и продлевает сертификат. Если её переадресовать,
    # сертификат для ivanborkovsky.ru не выпустить.
    RewriteCond %{REQUEST_URI} ^/\.well-known/
    RewriteRule ^ - [L]

    # 2. Страховка от ошибки при выкладке.
    #
    # Дальше идут правила, которые уводят с сайта ВСЁ. Если этот файл
    # попадёт не в ту папку, они закроют чужой сайт. Поэтому сначала
    # проверяем имя домена: не наш — ничего не делаем.
    RewriteCond %{HTTP_HOST} !^(www\.)?ivanborkovsky\.ru$ [NC]
    RewriteRule ^ - [L]

    # 3. Постраничный перенос.
    #
    # Слева — как адрес выглядел на старом сайте, справа — та же тема
    # на новом. Хвост (\.php)?/? в конце каждого образца нужен для того,
    # чтобы правило срабатывало на любой записи одного и того же адреса:
    # со слэшем на конце и без, с .php и без него.
    #
    # Код 301 — «переехали навсегда»: по нему поисковики переносят вес
    # старого адреса на новый и со временем заменяют его в выдаче.
    #
    # Метки рекламных кампаний (utm и подобные) сохраняются: Apache
    # дописывает их к новому адресу сам.
    RewriteRule ^contacts(\.php)?/?$        https://crm.ivanborkovsky.ru/kontakty [L,R=301]
    RewriteRule ^politic(\.php)?/?$         https://crm.ivanborkovsky.ru/privacy [L,R=301]
    RewriteRule ^personal_data(\.php)?/?$   https://crm.ivanborkovsky.ru/soglasie [L,R=301]

    RewriteRule ^uslugi/vnedrenie/vnedrenie-bitrix24(\.php)?/?$ https://crm.ivanborkovsky.ru/uslugi/vnedrenie-bitrix24 [L,R=301]
    RewriteRule ^uslugi/vnedrenie/vnedrenie-amocrm(\.php)?/?$ https://crm.ivanborkovsky.ru/uslugi/vnedrenie-amocrm [L,R=301]

    # Страницы тарифов ведут на соответствующую услугу: цен на новом
    # сайте нет, и ближе всего к «сколько стоит Битрикс24» — страница
    # о внедрении Битрикс24.
    RewriteRule ^tarify/tarify-bitrix24(\.php)?/?$ https://crm.ivanborkovsky.ru/uslugi/vnedrenie-bitrix24 [L,R=301]
    RewriteRule ^tarify/tarify-amocrm(\.php)?/?$ https://crm.ivanborkovsky.ru/uslugi/vnedrenie-amocrm [L,R=301]

    # Раздел услуг целиком — на список услуг нового сайта.
    RewriteRule ^uslugi(/vnedrenie)?/?$ https://crm.ivanborkovsky.ru/uslugi [L,R=301]

    # База знаний — на статьи. Сопоставить статью со статьёй нельзя:
    # на новом сайте это другие тексты с другими адресами. Поэтому
    # и отдельная статья, и любой раздел базы ведут на список статей,
    # где человек найдёт нужное поиском.
    RewriteRule ^baza-znanij(/.*)?$ https://crm.ivanborkovsky.ru/stati [L,R=301]

    # 4. Всё остальное — на главную нового сайта.
    RewriteRule ^ https://crm.ivanborkovsky.ru/ [L,R=301]
</IfModule>

# Список файлов в каталоге не показываем.
Options -Indexes
