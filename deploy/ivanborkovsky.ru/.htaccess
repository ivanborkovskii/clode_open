# Переадресация с основного домена на сайт по CRM.
#
# КУДА КЛАСТЬ: в корень домена ivanborkovsky.ru — туда, куда смотрит сам
# домен на хостинге. Это НЕ папка сайта crm.ivanborkovsky.ru: у каждого
# домена своя папка, и правила из чужой папки не действуют.
#
# ЧТО ДЕЛАЕТ: любой заход на ivanborkovsky.ru и www.ivanborkovsky.ru,
# по http и по https, отправляет на https://crm.ivanborkovsky.ru/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Каталог .well-known исключён: по нему удостоверяющий центр проверяет
    # права на домен при выпуске и продлении сертификата. Без этого
    # исключения сертификат для ivanborkovsky.ru не продлить — проверка
    # будет уезжать на другой домен.
    RewriteCond %{REQUEST_URI} !^/\.well-known/

    # Правило срабатывает только для основного домена. Это страховка
    # от ошибки: если файл попадёт в папку самого crm.ivanborkovsky.ru,
    # он ничего не сделает. Без этой строки сайт по CRM отправлял бы
    # сам на себя по кругу и перестал бы открываться.
    RewriteCond %{HTTP_HOST} ^(www\.)?ivanborkovsky\.ru$ [NC]

    # Переход один и сразу на нужный адрес: и имя домена, и протокол
    # исправляются за один раз, без промежуточных перескоков.
    #
    # Код 301 — «переехали навсегда». Поисковики по нему переносят вес
    # старого адреса на новый и со временем заменяют его в выдаче.
    #
    # Все адреса ведут на главную. Если на основном домене появятся свои
    # страницы и понадобится сохранять путь, конец строки меняется
    # на https://crm.ivanborkovsky.ru%{REQUEST_URI} — но тогда страницы
    # с обоих доменов должны совпадать, иначе люди будут попадать
    # на «страница не найдена».
    RewriteRule ^ https://crm.ivanborkovsky.ru/ [L,R=301]
</IfModule>

# Список файлов в каталоге не показываем.
Options -Indexes
