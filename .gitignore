storage/logs/*
!storage/logs/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep

# Картинки статей загружаются через админку и живут только на сервере:
# в репозитории им делать нечего, а .htaccess из этого каталога — нужен.
public/assets/img/stati/*/

# Настройки конкретного сервера: пароль к базе, ящик для заявок.
# В репозитории им не место, а рядом лежит образец local.primer.php.
config/local.php

.env
.DS_Store
node_modules/
build/
