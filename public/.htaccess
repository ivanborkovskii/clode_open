# Все запросы к несуществующим файлам обрабатывает index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Переезд на HTTPS. Раскомментируйте после того, как в панели Spaceweb
    # будет выпущен сертификат — до этого правило уведёт сайт в ошибку.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Список файлов в каталоге не показываем.
Options -Indexes

# Кэш статики: файлы отдаются с версией в адресе, поэтому срок можно ставить большой.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
