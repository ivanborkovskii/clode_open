# Все запросы к несуществующим файлам обрабатывает index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ЕДИНСТВЕННЫЙ АДРЕС САЙТА: https://crm.ivanborkovsky.ru
    #
    # У одной и той же страницы не должно быть четырёх адресов — с www
    # и без, по http и по https. Для поисковика это разные страницы
    # с одинаковым содержимым, и вес сайта делится между ними.
    #
    # Правил два, и порядок важен: имя сайта исправляется первым и сразу
    # вместе с протоколом. Поэтому с http://www переход всегда один,
    # а не два подряд — лишний перескок замедляет открытие и теряется
    # часть веса ссылки.
    #
    # Код переадресации — 308, а не 301. При 301 браузер превращает
    # отправку формы в обычный переход и теряет её содержимое: заявка
    # или комментарий, отправленные со страницы, открытой по http,
    # просто исчезли бы. 308 сохраняет и способ отправки, и данные,
    # а поисковики понимают его так же, как 301.

    # Переадресация с основного домена ivanborkovsky.ru живёт не здесь:
    # у него на хостинге своя папка со своим сайтом, и правила лежат
    # там — deploy/ivanborkovsky.ru/.htaccess.

    # 1. Убираем www. %1 — это имя сайта без него, из условия ниже.
    #
    # Каталог .well-known исключён и здесь, по той же причине, что ниже:
    # проверку прав на домен нельзя никуда уводить, иначе сертификат
    # для адреса с www не выпустить.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=308]

    # 2. Переводим на HTTPS.
    #
    # Проверок три, и все они обязательны. На хостинге HTTPS расшифровывается
    # на прокси-сервере перед Apache, и до Apache запрос доходит как обычный
    # http — переменная %{HTTPS} остаётся пустой даже у посетителя, пришедшего
    # по защищённому соединению. Если проверять только её, сайт уходит
    # в бесконечную переадресацию. Настоящий протокол прокси передаёт
    # заголовком, и у разных хостингов он называется по-разному, поэтому
    # смотрим оба распространённых варианта.
    #
    # Каталог .well-known исключён: по нему удостоверяющий центр проверяет
    # права на домен при выпуске и продлении сертификата. Если сертификат
    # успел истечь, а проверка уходит на https, продлить его не выйдет —
    # замкнутый круг.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP:X-Forwarded-SSL} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=308]

    # Каталог .well-known сайту не принадлежит: это служебный путь, по нему
    # удостоверяющий центр проверяет права на домен. Его надо исключить
    # и здесь, а не только в правиле выше.
    #
    # Иначе получается так: запрос к .well-known до переадресации не доходит
    # (правило выше его пропускает), зато доходит сюда и подменяется
    # на index.php. После подмены Apache прогоняет весь набор правил заново,
    # и на втором проходе адрес уже /index.php — исключение не срабатывает,
    # и проверка прав всё-таки уезжает на https, а наружу вылезает
    # внутренний index.php. Проверено: без этой строки так и происходит.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Список файлов в каталоге не показываем.
Options -Indexes

# Кэш статики: файлы отдаются с версией в адресе, поэтому срок можно ставить большой.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
