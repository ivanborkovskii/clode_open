# Все запросы к несуществующим файлам обрабатывает index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ЕДИНСТВЕННЫЙ АДРЕС САЙТА: https://ivanborkovsky.ru
    #
    # У одной и той же страницы не должно быть четырёх адресов — с www
    # и без, по http и по https. Для поисковика это разные страницы
    # с одинаковым содержимым, и вес сайта делится между ними.
    #
    # Правил два, и порядок важен: имя сайта исправляется первым и сразу
    # вместе с протоколом. Поэтому с http://www переход всегда один,
    # а не два подряд — лишний перескок замедляет открытие и теряется
    # часть веса ссылки.
    #
    # Код переадресации — 308, а не 301. При 301 браузер превращает
    # отправку формы в обычный переход и теряет её содержимое: заявка
    # или комментарий, отправленные со страницы, открытой по http,
    # просто исчезли бы. 308 сохраняет и способ отправки, и данные,
    # а поисковики понимают его так же, как 301.

    # Переадресация с поддомена crm.ivanborkovsky.ru, где сайт жил
    # раньше, живёт не здесь: у поддомена на хостинге своя папка,
    # и правило лежит там — deploy/crm.ivanborkovsky.ru/.htaccess.

    # 1. Убираем www. %1 — это имя сайта без него, из условия ниже.
    #
    # Каталог .well-known исключён и здесь, по той же причине, что ниже:
    # проверку прав на домен нельзя никуда уводить, иначе сертификат
    # для адреса с www не выпустить.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=308]

    # 2. Переводим на HTTPS.
    #
    # Проверок три, и все они обязательны. На хостинге HTTPS расшифровывается
    # на прокси-сервере перед Apache, и до Apache запрос доходит как обычный
    # http — переменная %{HTTPS} остаётся пустой даже у посетителя, пришедшего
    # по защищённому соединению. Если проверять только её, сайт уходит
    # в бесконечную переадресацию. Настоящий протокол прокси передаёт
    # заголовком, и у разных хостингов он называется по-разному, поэтому
    # смотрим оба распространённых варианта.
    #
    # Каталог .well-known исключён: по нему удостоверяющий центр проверяет
    # права на домен при выпуске и продлении сертификата. Если сертификат
    # успел истечь, а проверка уходит на https, продлить его не выйдет —
    # замкнутый круг.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP:X-Forwarded-SSL} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=308]

    # ПРЕЖНИЕ АДРЕСА СТАРОГО САЙТА
    #
    # На этом домене раньше стоял другой сайт. Его адреса известны
    # поисковикам и стоят в чужих ссылках, а страниц с такими адресами
    # здесь нет. Поэтому каждый ведёт на ту страницу нового сайта,
    # которая о том же: человек попадает туда, куда шёл, а поисковик
    # переносит на новый адрес вес старого.
    #
    # Правила должны стоять до подмены на index.php: иначе запрос уйдёт
    # в приложение и получит «страница не найдена» раньше, чем дойдёт
    # сюда.
    #
    # Хвост (\.php)?/? в конце образца срабатывает на любой записи одного
    # и того же адреса: со слэшем на конце и без, с .php и без него.
    # Метки рекламных кампаний Apache дописывает к новому адресу сам.
    #
    # Адреса, которым пары не нашлось, правил не получают намеренно.
    # Страница, которой нет, должна отвечать «не найдено». Увести их все
    # на главную было бы хуже: поисковик считает такую переадресацию
    # подменой и перестаёт доверять сайту.
    RewriteRule ^contacts(\.php)?/?$        https://ivanborkovsky.ru/kontakty [L,R=301]
    RewriteRule ^politic(\.php)?/?$         https://ivanborkovsky.ru/privacy [L,R=301]
    RewriteRule ^personal_data(\.php)?/?$   https://ivanborkovsky.ru/soglasie [L,R=301]

    RewriteRule ^uslugi/vnedrenie/vnedrenie-bitrix24(\.php)?/?$ https://ivanborkovsky.ru/uslugi/vnedrenie-bitrix24 [L,R=301]
    RewriteRule ^uslugi/vnedrenie/vnedrenie-amocrm(\.php)?/?$ https://ivanborkovsky.ru/uslugi/vnedrenie-amocrm [L,R=301]

    # Раздел внедрения целиком — на список услуг. Самого /uslugi здесь
    # нет намеренно: на новом сайте это настоящая страница, и правило
    # отправляло бы её саму на себя по кругу.
    RewriteRule ^uslugi/vnedrenie/?$ https://ivanborkovsky.ru/uslugi [L,R=301]

    # Тарифы Битрикс24 — на страницу тарифов: там те же лицензии и цены.
    # По amoCRM такой страницы нет, поэтому её тарифы ведут на услугу.
    RewriteRule ^tarify/tarify-bitrix24(\.php)?/?$ https://ivanborkovsky.ru/tarify/bitriks24 [L,R=301]
    RewriteRule ^tarify/tarify-amocrm(\.php)?/?$ https://ivanborkovsky.ru/uslugi/vnedrenie-amocrm [L,R=301]

    # База знаний — на статьи. Сопоставить статью со статьёй нельзя:
    # это другие тексты с другими адресами. Поэтому и отдельная статья,
    # и любой раздел базы ведут на список, где нужное находится поиском.
    RewriteRule ^baza-znanij(/.*)?$ https://ivanborkovsky.ru/stati [L,R=301]

    # Каталог .well-known сайту не принадлежит: это служебный путь, по нему
    # удостоверяющий центр проверяет права на домен. Его надо исключить
    # и здесь, а не только в правиле выше.
    #
    # Иначе получается так: запрос к .well-known до переадресации не доходит
    # (правило выше его пропускает), зато доходит сюда и подменяется
    # на index.php. После подмены Apache прогоняет весь набор правил заново,
    # и на втором проходе адрес уже /index.php — исключение не срабатывает,
    # и проверка прав всё-таки уезжает на https, а наружу вылезает
    # внутренний index.php. Проверено: без этой строки так и происходит.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Список файлов в каталоге не показываем.
Options -Indexes

# Кэш статики: файлы отдаются с версией в адресе, поэтому срок можно ставить большой.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
